    "shadow-plugin": "^2.1.0",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.22",
    "vue-i18n": "^11.4.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.1.0"
